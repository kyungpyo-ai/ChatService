# Supabase 프로젝트 URL/공개(anon) 키 — 클라이언트에 노출됨
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서버 전용 — 절대 클라이언트에 노출 금지 (NEXT_PUBLIC_ 접두사 사용 안 함)
# RLS를 우회하는 관리자 클라이언트(계정 탈퇴, 관리자 조회, 정리 배치 등)에 사용
SUPABASE_SERVICE_ROLE_KEY=
# /api/cron/* 배치 엔드포인트 인증용 임의 문자열 (Vercel Cron이 자동으로 Authorization 헤더에 붙임)
CRON_SECRET=

# 선택 — 커스텀 도메인 연결 전에는 비워둔다. 채우면 OG/메타데이터(metadataBase)가
# Vercel 프리뷰 도메인 대신 이 값을 가리킨다 (예: https://www.sudaon.com)
NEXT_PUBLIC_SITE_URL=

# 선택 — 광고. 비워두면 광고 영역이 아예 렌더링되지 않는다 (lib/ads/config.ts 참고)
# 카카오 애드핏 광고단위 ID (DAN-xxxx). inline=320x100, sidebar=160x600 크기로 생성
NEXT_PUBLIC_ADFIT_UNIT_INLINE=
NEXT_PUBLIC_ADFIT_UNIT_SIDEBAR=
# 구글 애드센스 게시자 ID(ca-pub-xxxx)와 위치별 광고 슬롯 ID — 같은 위치에 애드핏이 있으면 애드핏 우선
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_INLINE=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
